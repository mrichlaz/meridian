f (gain != null && gain > (a.max_gain_pct || 0)) {\n        updMax.run(Math.round(gain * 10) / 10, a.id);\n      }\n      if (age >= 15 * M && a.p15 == null && gain != null) {\n        updP15.run(Math.round(gain * 10) / 10, a.id);\n        updated++;\n      }\n      if (age >= 60 * M && a.p60 == null && gain != null) {\n        updP60.run(Math.round(gain * 10) / 10, a.id);\n        updated++;\n      }\n      if (age >= 360 * M) {\n        if (gain != null) {\n          updP360.run(Math.round(gain * 10) / 10, a.id);\n        } else {\n          resolveNoData.run(a.id); // token gone; nothing more to sample\n        }\n        resolved++;\n      }\n    }\n  })", "is_member_call": false, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/outcomes.js", "source_location": "L89"}, {"caller_nid": "bot_tracker_outcomes_resolveoutcomes", "callee": "transaction", "is_member_call": true, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/outcomes.js", "source_location": "L89"}, {"caller_nid": "bot_tracker_outcomes_resolveoutcomes", "callee": "log", "is_member_call": false, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/outcomes.js", "source_location": "L115"}, {"caller_nid": "bot_tracker_outcomes_unresolvedalertmints", "callee": "map", "is_member_call": true, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/outcomes.js", "source_location": "L121"}, {"caller_nid": "bot_tracker_outcomes_unresolvedalertmints", "callee": "all", "is_member_call": true, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/outcomes.js", "source_location": "L121"}, {"caller_nid": "bot_tracker_outcomes_unresolvedalertmints", "callee": "prepare", "is_member_call": true, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/outcomes.js", "source_location": "L121"}]}