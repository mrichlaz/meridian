on(() => {\n    for (const [sig, info] of parsed) {\n      insSeen.run(sig, now);\n      const wallet = walletBySig.get(sig) || null;\n      for (const m of info.mints) {\n        insEvent.run(sig, m, wallet, \"rpc\", info.ts);\n        upToken.run(m, info.ts, info.ts, info.ts);\n        stats.newEvents++;\n      }\n    }\n  })", "is_member_call": false, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/tracker.js", "source_location": "L189"}, {"caller_nid": "bot_tracker_tracker_recordparsed", "callee": "transaction", "is_member_call": true, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/tracker.js", "source_location": "L189"}, {"caller_nid": "bot_tracker_tracker_parseviarpc", "callee": "set", "is_member_call": true, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/tracker.js", "source_location": "L213"}, {"caller_nid": "bot_tracker_tracker_parseviarpc", "callee": "now", "is_member_call": true, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/tracker.js", "source_location": "L213"}, {"caller_nid": "bot_tracker_tracker_parseviarpc", "callee": "set", "is_member_call": true, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/tracker.js", "source_location": "L216"}, {"caller_nid": "bot_tracker_tracker_parseviarpc", "callee": "now", "is_member_call": true, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/tracker.js", "source_location": "L218"}, {"caller_nid": "bot_tracker_tracker_enrichtokens", "callee": "all", "is_member_call": true, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/tracker.js", "source_location": "L236"}, {"caller_nid": "bot_tracker_tracker_enrichtokens", "callee": "prepare", "is_member_call": true, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/tracker.js", "source_location": "L236"}, {"caller_nid": "bot_tracker_tracker_enrichtokens", "callee": "map", "is_member_call": true, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/tracker.js", "source_location": "L248"}, {"caller_nid": "bot_tracker_tracker_enrichtokens", "callee": "now", "is_member_call": true, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/tracker.js", "source_location": "L251"}, {"caller_nid": "bot_tracker_tracker_enrichtokens", "callee": "map", "is_member_call": true, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/tracker.js", "source_location": "L252"}, {"caller_nid": "bot_tracker_tracker_enrichtokens", "callee": "prepare", "is_member_call": true, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/tracker.js", "source_location": "L254"}, {"caller_nid": "bot_tracker_tracker_enrichtokens", "callee": "prepare", "is_member_call": true, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/tracker.js", "source_location": "L267"}, {"caller_nid": "bot_tracker_tracker_enrichtokens", "callee": "db.transaction(() => {\n    for (const [mint, d] of data) {\n      const prev = prevByMint.get(mint) || {};\n      // OBV: signed per-interval flow \u2014 add when price rises, subtract when it\n      // falls. Textbook OBV, using a fresh-flow proxy instead of diffing h24.\n      let obv = prev.obv || 0;\n      const flow = flowFrom(d, prev);\n      if (prev.price_usd != null && d.price != null) {\n        if (d.price > prev.price_usd) obv += flow;\n        else if (d.price < prev.price_usd) obv -= flow;\n      }\n      upToken.run(\n        d.symbol, d.name, d.dex,\n        d.price, d.liquidity, d.fdv, d.marketCap, d.volume,\n        prev.price_usd ?? null, prev.volume_h24 ?? null, prev.market_cap ?? null,\n        d.price ?? null,\n        d.pairCreatedAt ?? null,\n        d.buysH1 ?? null, d.sellsH1 ?? null, d.priceChangeH1 ?? null,\n        obv, now, now,\n        mint\n      );\n      insSnap.run(mint, now, d.price, d.marketCap, d.volume, d.liquidity, Math.round(flow), obv);\n    }\n  })", "is_member_call": false, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/tracker.js", "source_location": "L282"}, {"caller_nid": "bot_tracker_tracker_enrichtokens", "callee": "transaction", "is_member_call": true, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/tracker.js", "source_location": "L282"}, {"caller_nid": "bot_tracker_tracker_starttracker", "callee": "getDB", "is_member_call": false, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/tracker.js", "source_location": "L315"}, {"caller_nid": "bot_tracker_tracker_starttracker", "callee": "log", "is_member_call": false, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/tracker.js", "source_location": "L320"}, {"caller_nid": "bot_tracker_tracker_starttracker", "callee": "getTrackedWallets", "is_member_call": false, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/tracker.js", "source_location": "L320"}, {"caller_nid": "bot_tracker_tracker_starttracker", "callee": "(async function loop() {\n    while (!_stopped) {\n      try {\n        const stats = { newEvents: 0, errors: [] };\n\n        // 1. Collect NEW (unseen) signatures across wallets \u2014 1 RPC call/wallet.\n        const walletBySig = new Map();\n        const newSigs = [];\n        const seenStmt = db.prepare(\n          \"SELECT 1 FROM seen_sigs WHERE tx_signature=? LIMIT 1\"\n        );\n        for (const wallet of getTrackedWallets()) {\n          if (_stopped) break;\n          await sigrl.wait();\n          let sigs;\n          try {\n            sigs = await heliusCall(\"getSignaturesForAddress\", [\n              wallet,\n              { limit: CONFIG.sigLimit },\n            ]);\n          } catch {\n            continue;\n          }\n          for (const s of sigs) {\n            if (walletBySig.has(s.signature)) continue;\n            if (seenStmt.get(s.signature)) continue;\n            walletBySig.set(s.signature, wallet);\n            newSigs.push(s.signature);\n          }\n        }\n\n        // Bound the per-cycle parse budget (protects against very active bots).\n        const toParse = newSigs.slice(0, CONFIG.maxSigsPerCycle);\n\n        // 2. Parse in bulk. Prefer Helius Enhanced API (1 call / 100 sigs);\n        // fall back to per-sig getTransaction only when no Helius key exists.\n        if (toParse.length) {\n          let parsed = await parseEnhanced(toParse);\n          if (parsed === null) parsed = await parseViaRpc(txrl, toParse);\n          recordParsed(db, parsed, walletBySig, stats);\n        }\n\n        // Enrichment now runs on its own timer in index.js (all modes), so it\n        // keeps producing snapshots even when this poller is idle in stream\n        // mode. Nothing to enrich here.\n\n        if (stats.newEvents > 0) {\n          const c = db.prepare(\"SELECT COUNT(*) c FROM tokens\").get().c;\n          log(\n            \"tracker\",\n            `${toParse.length} new sigs \u2192 ${stats.newEvents} token events, ${c} tokens tracked`\n          );\n        }\n\n        if (Date.now() - lastHeartbeat > 300_000) {\n          const tk = db.prepare(\"SELECT COUNT(*) c FROM tokens\").get().c;\n          const ev = db.prepare(\"SELECT COUNT(*) c FROM events\").get().c;\n          log(\"tracker\", `Heartbeat \u2014 ${tk} tokens, ${ev} events`);\n          lastHeartbeat = Date.now();\n        }\n      } catch (e) {\n        log(\"tracker_error\", `Cycle error: ${e.message}`);\n      }\n      await new Promise((r) => setTimeout(r, CONFIG.pollInterval));\n    }\n    _running = false;\n    log(\"tracker\", \"Stopped\");\n  })", "is_member_call": false, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/tracker.js", "source_location": "L322"}, {"caller_nid": "bot_tracker_tracker_starttracker", "callee": "prepare", "is_member_call": true, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/tracker.js", "source_location": "L330"}, {"caller_nid": "bot_tracker_tracker_starttracker", "callee": "getTrackedWallets", "is_member_call": false, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/tracker.js", "source_location": "L333"}, {"caller_nid": "bot_tracker_tracker_starttracker", "callee": "has", "is_member_call": true, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/tracker.js", "source_location": "L346"}, {"caller_nid": "bot_tracker_tracker_starttracker", "callee": "get", "is_member_call": true, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/tracker.js", "source_location": "L347"}, {"caller_nid": "bot_tracker_tracker_starttracker", "callee": "set", "is_member_call": true, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/tracker.js", "source_location": "L348"}, {"caller_nid": "bot_tracker_tracker_starttracker", "callee": "push", "is_member_call": true, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/tracker.js", "source_location": "L349"}, {"caller_nid": "bot_tracker_tracker_starttracker", "callee": "slice", "is_member_call": true, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/tracker.js", "source_location": "L354"}, {"caller_nid": "bot_tracker_tracker_starttracker", "callee": "get", "is_member_call": true, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/tracker.js", "source_location": "L369"}, {"caller_nid": "bot_tracker_tracker_starttracker", "callee": "prepare", "is_member_call": true, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/tracker.js", "source_location": "L369"}, {"caller_nid": "bot_tracker_tracker_starttracker", "callee": "log", "is_member_call": false, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/tracker.js", "source_location": "L370"}, {"caller_nid": "bot_tracker_tracker_starttracker", "callee": "now", "is_member_call": true, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/tracker.js", "source_location": "L376"}, {"caller_nid": "bot_tracker_tracker_starttracker", "callee": "get", "is_member_call": true, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/tracker.js", "source_location": "L377"}, {"caller_nid": "bot_tracker_tracker_starttracker", "callee": "prepare", "is_member_call": true, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/tracker.js", "source_location": "L377"}, {"caller_nid": "bot_tracker_tracker_starttracker", "callee": "get", "is_member_call": true, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/tracker.js", "source_location": "L378"}, {"caller_nid": "bot_tracker_tracker_starttracker", "callee": "prepare", "is_member_call": true, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/tracker.js", "source_location": "L378"}, {"caller_nid": "bot_tracker_tracker_starttracker", "callee": "log", "is_member_call": false, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/tracker.js", "source_location": "L379"}, {"caller_nid": "bot_tracker_tracker_starttracker", "callee": "now", "is_member_call": true, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/tracker.js", "source_location": "L380"}, {"caller_nid": "bot_tracker_tracker_starttracker", "callee": "log", "is_member_call": false, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/tracker.js", "source_location": "L383"}, {"caller_nid": "bot_tracker_tracker_starttracker", "callee": "log", "is_member_call": false, "source_file": "/Users/ichlas/No-cloud/meridian/tools/bot-tracker/tracker.js", "source_location": "L388"}]}